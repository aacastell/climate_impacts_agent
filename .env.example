# Local model serving (Ollama)

OLLAMA_BASE_URL=http://localhost:11434
ROUTER_MODEL_NAME=qwen2.5-7b-instruct-router
NARRATOR_MODEL_NAME=qwen2.5-7b-instruct

# Data cache (ISIMIP/CMIP6 fetch-on-miss)
DATA_CACHE_DIR=./data/cache

# RAG
RAG_INDEX_DIR=./data/cache

# API
API_BASE_URL=http://127.0.0.1:8000
API_HOST=0.0.0.0
API_PORT=8000

# Orchestration adapter: mock | graph
ORCHESTRATION_BACKEND=mock

LOG_LEVEL=INFO

